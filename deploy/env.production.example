# Iris production environment — copy to /opt/iris/.env on the server.
#
#   install -m 600 /dev/null /opt/iris/.env   # create it empty and locked down
#   nano /opt/iris/.env                       # paste and fill in
#
# chmod 600. This file holds the service-role key and the Paystack secret;
# anything that can read it can read and write the whole database.
#
# Values marked (Render) can be copied straight out of the current Render
# service's Environment tab — they do not change in the move.

# ---- Supabase (Render) ------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (Render) ----------------------------------------------------------
# Must match what's live: changing JWT_SECRET signs everyone out.
JWT_SECRET=
JWT_EXPIRATION=7d

# ---- Payments (Render) ------------------------------------------------------
PAYSTACK_SECRET_KEY=

# ---- Public URLs ------------------------------------------------------------
# Used for customer-facing links in email/SMS, and for the CORS allow-list.
FRONTEND_URL=https://1nri.store
ADMIN_URL=https://admin.1nri.store

# ---- Recommender ------------------------------------------------------------
# Set by docker-compose.yml to the internal service name; listed here only so
# the full set of keys is visible in one place. No need to fill it in.
# RECOMMENDER_URL=http://recommender:8000

# ---- SMS: LetsFish (Render) -------------------------------------------------
LETSFISH_APP_ID=
LETSFISH_SENDER_ID=
LETSFISH_APP_SECRET=

# ---- Email: Resend (Render) -------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
STAFF_FULFILLMENT_EMAIL=

# ---- Runtime ----------------------------------------------------------------
# NODE_ENV, PORT, LOG_FORMAT, INSTANCE_ID and RUN_CRONS are all set per-service
# in docker-compose.yml, and a service's `environment:` block wins over this
# file — so setting RUN_CRONS here has no effect. Leave it out anyway; the only
# place the scheduler switch should be readable is the compose file.
